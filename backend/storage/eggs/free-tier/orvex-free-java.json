    "description": "Creates a container that runs java.",
    "features": [],
    "docker_images": {
        "Java 21": "ghcr.io/pelican-eggs/yolks:java_21",
        "Java 17": "ghcr.io/pelican-eggs/yolks:java_17",
        "Java 11": "ghcr.io/pelican-eggs/yolks:java_11",
        "Java 8": "ghcr.io/pelican-eggs/yolks:java_8",
        "Java 19": "ghcr.io/pelican-eggs/yolks:java_19",
        "Java 16": "ghcr.io/pelican-eggs/yolks:java_16"
    },
    "file_denylist": [],
    "startup": "echo Starting your app; java -Dterminal.jline=false -Dterminal.ansi=true -jar {{JARFILE}}",
    "config": {
        "files": "[]",
        "startup": "{\n    \"done\": [\n        \"Starting your app\"\n    ]\n}",
        "logs": "[]",
        "stop": "^C"
    },
    "scripts": {
        "installation": {
            "script": "#!/bin/bash\n# Java Installation Script\n#\n# Server Files: /mnt/server\nPROJECT=java\n\ncd /mnt/server",
            "container": "ghcr.io/pelican-eggs/yolks:debian",
            "entrypoint": "bash"
        }
    },
    "variables": [
        {
            "name": "JAR FILE",
            "description": "",
            "env_variable": "JARFILE",
            "default_value": "app.jar",
            "user_viewable": true,
            "user_editable": true,
            "rules": "required|string|max:50",
            "field_type": "text"
        }
    ]
